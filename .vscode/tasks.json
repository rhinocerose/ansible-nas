{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Playbook",
            "type": "shell",
            "command": "ansible-playbook -i inventories/pooter/inventory nas.yml -b -K",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Playbook Syntax Check",
            "type": "shell",
            "command": "ansible-playbook -i inventories/pooter/inventory nas.yml --syntax-check",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run pre-commit checks",
            "type": "shell",
            "command": "pre-commit run --all-files",
            "group": "test"
        },
        {
            "label": "Serve docs locally (Docusaurus)",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceFolder}/website"
            },
            "group": "test"
        },
        {
            "label": "Build docs (Docusaurus)",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/website"
            },
            "group": "build"
        }
    ]
}
